    <node id="Estimation">
      <data key="d0">Estimation</data>
      <data key="d1">category</data>
      <data key="d2">Estimation refers to the process of assessing the effort and resources needed to transform inputs into desired outputs, critical for project planning.</data>
      <data key="d3">chunk-ce656892960bdf19bad87a40627f43b9</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
