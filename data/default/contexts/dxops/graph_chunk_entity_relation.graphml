      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="Inputs and Outputs">
      <data key="d0">Inputs and Outputs</data>
      <data key="d1">category</data>
      <data key="d2">Inputs and Outputs represent the data and materials that enter and exit a process, critical for understanding process dynamics.</data>
