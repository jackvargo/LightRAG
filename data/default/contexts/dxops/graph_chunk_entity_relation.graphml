    <node id="Digitalization Efforts">
      <data key="d0">Digitalization Efforts</data>
      <data key="d1">category</data>
      <data key="d2">Digitalization Efforts encompass various initiatives aimed at integrating digital technologies into operational processes to enhance performance.</data>
