      <data key="d0">Finance / Business Analysts</data>
      <data key="d1">person</data>
      <data key="d2">Finance / Business Analysts analyze financial data and business processes, providing insights that can influence digitalization strategies.&lt;SEP&gt;Finance / Business Analysts analyze financial data and provide insights to support business decisions and strategies.</data>
