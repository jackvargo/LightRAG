    <node id="Environment Setup">
      <data key="d0">Environment Setup</data>
      <data key="d1">category</data>
      <data key="d2">Environment Setup is the process of preparing the development environment to support new features, ensuring all necessary tools and configurations are in place.</data>
      <data key="d3">chunk-ce656892960bdf19bad87a40627f43b9</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="Architectural Design">
      <data key="d0">Architectural Design</data>
      <data key="d1">category</data>
      <data key="d2">Architectural Design involves planning the high-level structure of a system, ensuring it meets requirements and is scalable.</data>
      <data key="d3">chunk-ce656892960bdf19bad87a40627f43b9</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="UI/UX Design">
      <data key="d0">UI/UX Design</data>
      <data key="d1">category</data>
      <data key="d2">UI/UX Design focuses on creating user interfaces and experiences that are intuitive and effective for end-users.</data>
      <data key="d3">chunk-ce656892960bdf19bad87a40627f43b9</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="Database Design">
      <data key="d0">Database Design</data>
      <data key="d1">category</data>
      <data key="d2">Database Design pertains to structuring and organizing data within a database to support application functionality and performance.</data>
      <data key="d3">chunk-ce656892960bdf19bad87a40627f43b9</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="Integration Testing">
      <data key="d0">Integration Testing</data>
      <data key="d1">category</data>
      <data key="d2">Integration Testing ensures that different components of the system work together correctly after integration.</data>
      <data key="d3">chunk-ce656892960bdf19bad87a40627f43b9</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="End-to-End Testing">
      <data key="d0">End-to-End Testing</data>
      <data key="d1">category</data>
