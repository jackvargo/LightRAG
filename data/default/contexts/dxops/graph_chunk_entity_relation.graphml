    <node id="RoviSys Team Members">
      <data key="d0">RoviSys Team Members</data>
      <data key="d1">person</data>
      <data key="d2">RoviSys Team Members are individuals from RoviSys who lead workshops, conduct interviews, and document findings during the sessions.</data>
      <data key="d3">chunk-95c578743c1a5b9a5c0b24ae18da2647</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="RACI Model">
      <data key="d0">RACI Model</data>
      <data key="d1">category</data>
      <data key="d2">RACI Model is a responsibility assignment matrix that clarifies roles and responsibilities among participants in digitalization projects.&lt;SEP&gt;The RACI model is a framework used to define roles and responsibilities within a project, ensuring clarity in task assignment and accountability.</data>
      <data key="d3">chunk-daea1eb8cfe8bd74c6b0ab853d03a193&lt;SEP&gt;chunk-5e1f46454562875f5de23d46e56265cd</data>
      <data key="d4">RAPs for MES - Development.pdf</data>
    </node>
    <node id="Stakeholder Interview RACI Items">
