  <graph edgedefault="undirected">
    <node id="Evening Primrose Oil">
      <data key="d0">Evening Primrose Oil</data>
      <data key="d1">category</data>
      <data key="d2">Evening Primrose Oil is a natural oil that contains GLA, which is known to decrease ornithine carboxylase activity in breast tumors and acts as a hormone regulator.&lt;SEP&gt;Evening Primrose Oil is a source of Gamma Linolenic Acid (GLA) and is suggested for hormone regulation in breast cancer.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04&lt;SEP&gt;chunk-4cd4bc5e9a136df75fab351b8b07616f</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="GLA">
      <data key="d0">GLA</data>
      <data key="d1">category</data>
      <data key="d2">GLA (Gamma-Linolenic Acid) is a fatty acid found in Evening Primrose Oil that decreases ornithine carboxylase activity in breast tumors and is suggested to be taken at a dose of around 2g daily.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="Paclitaxel">
      <data key="d0">Paclitaxel</data>
      <data key="d1">category</data>
      <data key="d2">Paclitaxel is a chemotherapy drug that, when used in conjunction with GLA, can increase the response to Tamoxifen in breast cancer treatment.&lt;SEP&gt;Paclitaxel is a chemotherapy drug whose efficacy can be influenced by P-Glycoprotein and other drug resistance mechanisms.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04&lt;SEP&gt;chunk-b2405fce9bf1e9596eff6dd81273a458</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="Tamoxifen">
      <data key="d0">Tamoxifen</data>
      <data key="d1">category</data>
      <data key="d2">Tamoxifen is a medication used to treat hormone receptor-positive breast cancer and is noted to be more effective when combined with GLA.&lt;SEP&gt;Tamoxifen is a medication used to treat hormone receptor-positive breast cancer.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04&lt;SEP&gt;chunk-2c8a13a1d7994bb3d188bcbdc68feefa</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="Grapeseed Extract OPCs">
      <data key="d0">Grapeseed Extract OPCs</data>
      <data key="d1">category</data>
      <data key="d2">Grapeseed Extract OPCs are natural aromatase inhibitors that may play a role in breast cancer treatment.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="Green Tea EGCG">
      <data key="d0">Green Tea EGCG</data>
      <data key="d1">category</data>
      <data key="d2">EGCG (Epigallocatechin gallate) is a compound found in green tea known for its antioxidant and anti-cancer effects.&lt;SEP&gt;EGCG (Epigallocatechin gallate) is a powerful antioxidant found in green tea, known for its potential health benefits, including cancer prevention.&lt;SEP&gt;Green Tea EGCG is a compound that acts as a regulator of histone proteins and has implications in reducing drug resistance in cancer treatment.&lt;SEP&gt;Green Tea EGCG is a compound that reduces the risk of recurrence by 50% in post-operative stage I and II breast cancer and inhibits breast cancer cells via the aryl hydrocarbon receptor.&lt;SEP&gt;Green Tea EGCG is a natural compound that acts as a regulator of histone proteins and may help in reducing drug resistance in cancer treatment.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04&lt;SEP&gt;chunk-ea5b318e2a8248e37e47eace395c05b5&lt;SEP&gt;chunk-85c06ae3e33dd062c6f8cbc3263674c7&lt;SEP&gt;chunk-b2405fce9bf1e9596eff6dd81273a458&lt;SEP&gt;chunk-0049dde5f6453f5037ca54e07e32cce4</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="Indole-3 Carbinol 13C">
      <data key="d0">Indole-3 Carbinol 13C</data>
      <data key="d1">category</data>
      <data key="d2">Indole-3 Carbinol 13C is a compound that suppresses estrogen activity in ER+ breast cancer and reduces the risk of recurrence.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
    <node id="DIM">
      <data key="d0">DIM</data>
      <data key="d1">category</data>
      <data key="d2">DIM (Diindolylmethane) is a compound derived from Indole-3 Carbinol that is taken to inhibit estrogen activity in breast cancer treatment.&lt;SEP&gt;DIM (Diindolylmethane) is a compound derived from indole 3 carbinol that may support healthy estrogen metabolism.</data>
      <data key="d3">chunk-f0633d0c9fbeab3f25914885985ace04&lt;SEP&gt;chunk-0049dde5f6453f5037ca54e07e32cce4</data>
      <data key="d4">Breast Cancer Example ER .pdf</data>
    </node>
