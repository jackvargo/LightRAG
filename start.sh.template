#!/bin/bash
# LightRAG Docker Start Script

set -e

# Check if Docker is running
if ! docker info > /dev/null 2>&1; then
  echo "Error: Docker is not running. Please start Docker Desktop and try again."
  exit 1
fi

# Check for .env file
if [ ! -f ".env" ]; then
  echo "Error: .env file not found. Please run the setup script first."
  exit 1
fi

# Get port from .env or use default
PORT=$(grep -o 'PORT=[0-9]*' .env | cut -d= -f2 || echo 9621)

echo "Starting LightRAG with Docker Compose..."
docker compose up -d

# Check if the service started successfully
if [ $? -eq 0 ]; then
  echo "✅ LightRAG is now running!"
  echo "🌐 Web interface: http://localhost:${PORT}"
  echo "🔑 Default login: admin / admin123 (unless modified in environment variables)"
  echo ""
  echo "📁 Place your documents in the 'inputs' folder for processing."
  echo "⚙️  Configuration is stored in the .env file."
  echo ""
  echo "To stop LightRAG, run: ./stop.sh"
else
  echo "❌ Error starting LightRAG. Check Docker logs for details:"
  echo "docker compose logs"
fi 