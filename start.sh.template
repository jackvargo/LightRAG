#!/bin/bash
# LightRAG Docker Start Script

set -e

# Initialize with default values
WORKING_DIR="./data/rag_storage"
INPUT_DIR="./data/inputs"

# Function to display help
show_help() {
    echo "Usage: $0 [options]"
    echo ""
    echo "Options:"
    echo "  --working-dir DIR   Set custom working directory for RAG storage (default: ./data/rag_storage)"
    echo "  --input-dir DIR     Set custom input directory for documents (default: ./data/inputs)"
    echo "  -h, --help          Show this help message"
    echo ""
    echo "Example:"
    echo "  $0 --working-dir ./data/project1_storage --input-dir ./data/project1_inputs"
    echo ""
    echo "Environment:"
    echo "  Requires Docker and .env file to be configured"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --working-dir)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --working-dir requires a directory path"
                exit 1
            fi
            WORKING_DIR="$2"
            shift 2
            ;;
        --input-dir)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --input-dir requires a directory path"
                exit 1
            fi
            INPUT_DIR="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
done

# Check if Docker is running
if ! docker info > /dev/null 2>&1; then
  echo "❌ Error: Docker is not running. Please start Docker Desktop and try again."
  exit 1
fi

# Check for .env file
if [ ! -f ".env" ]; then
  echo "❌ Error: .env file not found. Please run the setup script first."
  exit 1
fi

# Create directories if they don't exist
echo "📁 Setting up directories..."
mkdir -p "$WORKING_DIR"
mkdir -p "$INPUT_DIR"

# Get absolute paths
WORKING_DIR_ABS=$(realpath "$WORKING_DIR")
INPUT_DIR_ABS=$(realpath "$INPUT_DIR")

# Get port from .env or use default
PORT=$(grep -o 'PORT=[0-9]*' .env | cut -d= -f2 || echo 9621)

echo "🚀 Starting LightRAG with Docker Compose..."
echo "📂 Working directory: $WORKING_DIR_ABS"
echo "📁 Input directory: $INPUT_DIR_ABS"

# Export variables for docker compose volume mounting
export LIGHTRAG_WORKING_DIR="$WORKING_DIR_ABS"
export LIGHTRAG_INPUT_DIR="$INPUT_DIR_ABS"

# Start docker compose with the custom environment variables
docker compose up -d

# Check if the service started successfully
if [ $? -eq 0 ]; then
  echo ""
  echo "✅ LightRAG is now running!"
  echo "🌐 Web interface: http://localhost:${PORT}"
  echo "🔑 Default login: admin / admin123 (unless modified in environment variables)"
  echo ""
  echo "📁 Document processing:"
  echo "   → Input directory: $INPUT_DIR_ABS"
  echo "   → Working directory: $WORKING_DIR_ABS"
  echo "⚙️  Configuration is stored in the .env file."
  echo ""
  echo "To stop LightRAG, run: ./stop.sh"
else
  echo ""
  echo "❌ Error starting LightRAG. Check Docker logs for details:"
  echo "   docker compose logs"
fi 