#!/bin/bash
# LightRAG Docker Stop Script

set -e

# Check if Docker is running
if ! docker info > /dev/null 2>&1; then
  echo "Error: Docker is not running. Please start Docker Desktop and try again."
  exit 1
fi

echo "Stopping LightRAG..."
docker compose down

if [ $? -eq 0 ]; then
  echo "✅ LightRAG has been stopped successfully."
  echo ""
  echo "To start LightRAG again, run: ./start.sh"
else
  echo "❌ Error stopping LightRAG. You can try forcing it with:"
  echo "docker compose down --remove-orphans"
fi 